+// Set by main's ROM search, before the UI (and the launcher in it) is made: whether the game has a ROM, and the
+// first ROM file found in the title folder that librecomp refused, and why.
+static bool ps5_rom_found = false;
+static std::string ps5_refused_rom;
+static recomp::RomValidationError ps5_refused_rom_error = recomp::RomValidationError::Good;
+
+// The launcher's message on the PS5, where it only shows when no usable ROM was found: where the ROM goes. The
+// whole options menu (the message, then Exit) is one dark card, so the text and Exit's pulsing highlight stay
+// readable over the background picture.
+static void add_ps5_rom_message(recompui::GameOptionsMenu *menu) {
+    auto context = recompui::get_current_context();
+    menu->set_background_color({ 0x00, 0x00, 0x00, 0xE0 });
+    menu->set_border_radius(16.0f);
+    menu->set_padding_bottom(16.0f);
+    recompui::Element *panel = context.create_element<recompui::Element>(menu, 0);
+    panel->set_display(recompui::Display::Flex);
+    panel->set_flex_direction(recompui::FlexDirection::Column);
+    panel->set_gap(16.0f);
+    panel->set_padding(32.0f);
+    panel->set_width(100.0f, recompui::Unit::Percent);
+
+    auto *title = context.create_element<recompui::Label>(panel,
+        ps5_refused_rom.empty() ? "ROM not found" : "This ROM can't be used", recompui::theme::Typography::Header2);
+    title->set_font_family("Suplexmentary Comic NC");
+
+    // Each line, and whether it's a path (shown larger, in the theme's colour).
+    std::vector<std::pair<std::string, bool>> lines;
+    if (!ps5_refused_rom.empty()) {
+        const char *reason = "it couldn't be used";
+        switch (ps5_refused_rom_error) {
+            case recomp::RomValidationError::IncorrectVersion: reason = "it's another version of Donkey Kong 64"; break;
+            case recomp::RomValidationError::IncorrectRom: reason = "it isn't Donkey Kong 64"; break;
+            case recomp::RomValidationError::NotARom: reason = "it isn't an N64 ROM"; break;
+            case recomp::RomValidationError::FailedToOpen: reason = "it couldn't be read"; break;
+            default: break;
+        }
+        lines.push_back({ ps5_refused_rom + " is in the game's folder, but " + reason + ".", false });
+    }
+    // The title folder's name only: the game can be installed on the console's storage, a USB drive or M.2 storage,
+    // and a title can't see which (it sees its folder as /app0).
+    lines.push_back({ "Copy your Donkey Kong 64 ROM into the game's folder, next to eboot.bin:", false });
+    lines.push_back({ "PPSA64064", true });
+    lines.push_back({ "It has to be the USA version (1.0), as a .z64, .n64 or .v64 file. Then start the game again.", false });
+    for (const auto& [text, path] : lines) {
+        auto *label = context.create_element<recompui::Label>(panel, text,
+            path ? recompui::theme::Typography::LabelLG : recompui::theme::Typography::Body);
+        label->set_white_space(recompui::WhiteSpace::Normal);
+        if (path) {
+            label->set_color(recompui::theme::color::Primary);
+        }
+    }
+}
+#endif
