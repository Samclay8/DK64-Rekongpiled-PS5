diff --git a/src/gui/rt64_performance_overlay.cpp b/src/gui/rt64_performance_overlay.cpp
new file mode 100644
index 0000000..8b8872e
--- /dev/null
+++ b/src/gui/rt64_performance_overlay.cpp
@@ -0,0 +1,433 @@
+//
+// RT64
+//
+// Performance overlay (DK64 PS5 port). See rt64_performance_overlay.h.
+//
+
+#include "rt64_performance_overlay.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <mutex>
+#include <unordered_map>
+
+#include "imgui/imgui.h"
+
+// Volk must be included before the ImGui Vulkan backend.
+#include "plume_vulkan.h"
+
+#include "imgui/backends/imgui_impl_vulkan.h"
+
+#if defined(__PROSPERO__)
+#   include <ps5platform/heap.h>
+#   include <ps5platform/kernel.h>
+#endif
+
+namespace {
+    std::atomic<int> overlayMode{ 0 };
+    std::mutex fontPathMutex;
+    std::string fontPath;
+
+    void checkOverlayVulkanResult(VkResult res) {
+        if (res != 0) {
+            fprintf(stderr, "[overlay] ImGui Vulkan backend error 0x%X\n", res);
+        }
+    }
+
+    struct MemoryInfo {
+        bool valid = false;
+        size_t heapMapped = 0;
+        size_t heapPeak = 0;
+        size_t directTotal = 0;
+        size_t directFree = 0;
+        size_t flexibleConfigured = 0;
+        size_t flexibleFree = 0;
+    };
+
+    MemoryInfo queryMemory() {
+        MemoryInfo info;
+#if defined(__PROSPERO__)
+        // The title's heap in direct memory (every malloc goes there), and what the kernel reports free:
+        // direct memory (also where RADV's textures and buffers live) and the flexible-memory budget.
+        struct ps5_heap_stats heap {};
+        ps5_heap_stats(&heap);
+        info.heapMapped = heap.mapped_bytes;
+        info.heapPeak = heap.peak_bytes;
+        const int64_t total = sceKernelGetDirectMemorySize();
+        int64_t start = 0;
+        size_t available = 0;
+        if ((total > 0) && (sceKernelAvailableDirectMemorySize(0, total, PS5_KERNEL_DIRECT_ALIGNMENT, &start, &available) == 0)) {
+            info.directTotal = size_t(total);
+            info.directFree = available;
+        }
+        sceKernelConfiguredFlexibleMemorySize(&info.flexibleConfigured);
+        sceKernelAvailableFlexibleMemorySize(&info.flexibleFree);
+        info.valid = true;
+#endif
+        return info;
+    }
+
+    MemoryInfo lastMemory;
+
+    float toMiB(size_t bytes) {
+        return float(double(bytes) / (1024.0 * 1024.0));
+    }
+
+    // Text with a soft shadow, right-aligned to rightX, as PCSX2 draws its overlay lines.
+    void drawRightAlignedText(ImDrawList *drawList, float rightX, float &y, float scale, ImU32 color, const char *text) {
+        ImFont *font = ImGui::GetFont();
+        const float size = ImGui::GetFontSize();
+        const ImVec2 textSize = font->CalcTextSizeA(size, FLT_MAX, 0.0f, text);
+        const ImVec2 pos(rightX - textSize.x, y);
+        const float shadow = std::ceil(scale * 1.5f);
+        drawList->AddText(font, size, ImVec2(pos.x + shadow, pos.y + shadow), IM_COL32(0, 0, 0, 160), text);
+        drawList->AddText(font, size, pos, color, text);
+        y += textSize.y + 2.0f * scale;
+    }
+
+    ImU32 fpsColor(float fps, uint32_t targetRate) {
+        const float target = (targetRate > 0) ? float(targetRate) : 60.0f;
+        if (fps >= target * 0.95f) {
+            return IM_COL32(120, 255, 120, 255);
+        }
+        else if (fps >= target * 0.5f) {
+            return IM_COL32(255, 220, 90, 255);
+        }
+        else {
+            return IM_COL32(255, 100, 100, 255);
+        }
+    }
+}
+
+namespace RT64 {
+    struct PerformanceOverlayVulkan {
+        VkDevice device = VK_NULL_HANDLE;
+        VkRenderPass renderPass = VK_NULL_HANDLE;
+        VkDescriptorPool descriptorPool = VK_NULL_HANDLE;
+
+        ~PerformanceOverlayVulkan() {
+            if (renderPass != VK_NULL_HANDLE) {
+                vkDestroyRenderPass(device, renderPass, nullptr);
+            }
+
+            if (descriptorPool != VK_NULL_HANDLE) {
+                vkDestroyDescriptorPool(device, descriptorPool, nullptr);
+            }
+        }
+    };
+
+    void PerformanceOverlay::setMode(Mode mode) {
+        overlayMode.store(int(mode));
+    }
+
+    PerformanceOverlay::Mode PerformanceOverlay::getMode() {
+        return Mode(overlayMode.load());
+    }
+
+    void PerformanceOverlay::setFontPath(const std::string &path) {
+        const std::lock_guard<std::mutex> lock(fontPathMutex);
+        fontPath = path;
+    }
+
+    PerformanceOverlay::PerformanceOverlay(RenderDevice *device, const RenderSwapChain *swapChain) {
+        this->device = device;
+        this->swapChain = swapChain;
+        lastPresent = Clock::now();
+        windowStart = lastPresent;
+        lastLog = lastPresent;
+    }
+
+    PerformanceOverlay::~PerformanceOverlay() {
+        if (context != nullptr) {
+            ImGuiContext *previous = ImGui::GetCurrentContext();
+            ImGui::SetCurrentContext(context);
+            ImGui_ImplVulkan_Shutdown();
+            vulkan.reset();
+            ImGui::DestroyContext(context);
+            ImGui::SetCurrentContext((previous == context) ? nullptr : previous);
+        }
+    }
+
+    // ImGui and its Vulkan backend, made the first time the overlay is shown. Its own context, so it never
+    // touches the inspector's.
+    void PerformanceOverlay::initImGui(float scale) {
+        ImGuiContext *previous = ImGui::GetCurrentContext();
+        context = ImGui::CreateContext();
+        ImGui::SetCurrentContext(context);
+
+        ImGuiIO &io = ImGui::GetIO();
+        io.IniFilename = nullptr;
+        io.LogFilename = nullptr;
+        ImGui::StyleColorsDark();
+
+        std::string path;
+        {
+            const std::lock_guard<std::mutex> lock(fontPathMutex);
+            path = fontPath;
+        }
+
+        ImFont *font = nullptr;
+        if (!path.empty()) {
+            ImFontConfig fontConfig;
+            fontConfig.OversampleH = 2;
+            font = io.Fonts->AddFontFromFileTTF(path.c_str(), std::round(20.0f * scale), &fontConfig);
+        }
+
+        if (font == nullptr) {
+            ImFontConfig fontConfig;
+            fontConfig.SizePixels = std::round(13.0f * scale);
+            io.Fonts->AddFontDefault(&fontConfig);
+            fprintf(stderr, "[overlay] font '%s' not loaded, using ImGui's own\n", path.c_str());
+        }
+
+        VulkanDevice *interfaceDevice = static_cast<VulkanDevice *>(device);
+        const VulkanSwapChain *interfaceSwapChain = static_cast<const VulkanSwapChain *>(swapChain);
+        ImGui_ImplVulkan_LoadFunctions([](const char *functionName, void *vulkanInstance) {
+            return vkGetInstanceProcAddr(*(reinterpret_cast<VkInstance *>(vulkanInstance)), functionName);
+        }, &interfaceDevice->renderInterface->instance);
+
+        std::unordered_map<VkDescriptorType, uint32_t> typeCounts;
+        typeCounts[VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER] = 1;
+
+        vulkan = std::make_unique<PerformanceOverlayVulkan>();
+        vulkan->device = interfaceDevice->vk;
+        vulkan->renderPass = VulkanGraphicsPipeline::createRenderPass(interfaceDevice, &interfaceSwapChain->pickedSurfaceFormat.format, 1, VK_FORMAT_UNDEFINED, VK_SAMPLE_COUNT_1_BIT);
+        vulkan->descriptorPool = VulkanDescriptorSet::createDescriptorPool(interfaceDevice, typeCounts, false);
+
+        ImGui_ImplVulkan_InitInfo initInfo = {};
+        initInfo.Instance = interfaceDevice->renderInterface->instance;
+        initInfo.PhysicalDevice = interfaceDevice->physicalDevice;
+        initInfo.Device = vulkan->device;
+        initInfo.QueueFamily = interfaceSwapChain->commandQueue->familyIndex;
+        initInfo.Queue = interfaceSwapChain->commandQueue->queue->vk;
+        initInfo.DescriptorPool = vulkan->descriptorPool;
+        initInfo.RenderPass = vulkan->renderPass;
+        initInfo.Subpass = 0;
+        initInfo.MinImageCount = 2;
+        initInfo.ImageCount = 2;
+        initInfo.CheckVkResultFn = &checkOverlayVulkanResult;
+        ImGui_ImplVulkan_Init(&initInfo);
+
+        ImGui::SetCurrentContext(previous);
+        fprintf(stderr, "[overlay] ready (font %.0f px)\n", std::round(20.0f * scale));
+    }
+
+    void PerformanceOverlay::recordPresent(bool newGameFrame, uint32_t rate) {
+        const Clock::time_point now = Clock::now();
+        const float frameMs = std::chrono::duration<float, std::milli>(now - lastPresent).count();
+        lastPresent = now;
+        targetRate = rate;
+
+        windowPresents++;
+        if (newGameFrame) {
+            windowGameFrames++;
+        }
+
+        if (windowPresents == 1) {
+            windowMinMs = frameMs;
+            windowMaxMs = frameMs;
+        }
+        else {
+            windowMinMs = std::min(windowMinMs, frameMs);
+            windowMaxMs = std::max(windowMaxMs, frameMs);
+        }
+
+        frameTimeHistory[historyPos] = frameMs;
+        fpsHistory[historyPos] = (frameMs > 0.0f) ? (1000.0f / frameMs) : 0.0f;
+        historyPos = (historyPos + 1) % HistorySize;
+        historyCount = std::min(historyCount + 1, HistorySize);
+
+        const float windowSeconds = std::chrono::duration<float>(now - windowStart).count();
+        if (windowSeconds >= 1.0f) {
+            displayFps = float(windowPresents) / windowSeconds;
+            gameFps = float(windowGameFrames) / windowSeconds;
+            avgFrameMs = (windowSeconds * 1000.0f) / float(windowPresents);
+            minFrameMs = windowMinMs;
+            maxFrameMs = windowMaxMs;
+            windowStart = now;
+            windowPresents = 0;
+            windowGameFrames = 0;
+            lastMemory = queryMemory();
+        }
+
+        // The same numbers in the log every 10 seconds, whether the overlay is shown or not.
+        if (std::chrono::duration<float>(now - lastLog).count() >= 10.0f) {
+            lastLog = now;
+            if (lastMemory.valid) {
+                fprintf(stderr, "[perf] display %.1f fps, game %.1f fps, frame %.2f ms (min %.2f, max %.2f), target %u Hz, heap %.0f MiB (peak %.0f), direct free %.0f of %.0f MiB, flexible free %.0f of %.0f MiB\n",
+                    displayFps, gameFps, avgFrameMs, minFrameMs, maxFrameMs, targetRate,
+                    toMiB(lastMemory.heapMapped), toMiB(lastMemory.heapPeak), toMiB(lastMemory.directFree), toMiB(lastMemory.directTotal),
+                    toMiB(lastMemory.flexibleFree), toMiB(lastMemory.flexibleConfigured));
+            }
+            else {
+                fprintf(stderr, "[perf] display %.1f fps, game %.1f fps, frame %.2f ms (min %.2f, max %.2f), target %u Hz\n",
+                    displayFps, gameFps, avgFrameMs, minFrameMs, maxFrameMs, targetRate);
+            }
+        }
+    }
+
+    void PerformanceOverlay::drawInfoBox(Mode mode, float scale, float margin, float &y, float width) {
+        ImDrawList *drawList = ImGui::GetBackgroundDrawList();
+        const float rightX = width - margin;
+        char line[192];
+
+        snprintf(line, sizeof(line), "%.0f FPS  (game %.0f)", displayFps, gameFps);
+        drawRightAlignedText(drawList, rightX, y, scale, fpsColor(displayFps, targetRate), line);
+
+        if (mode != Mode::Detailed) {
+            return;
+        }
+
+        const ImU32 white = IM_COL32(255, 255, 255, 255);
+        snprintf(line, sizeof(line), "Frame %.2f ms  (min %.2f, max %.2f)", avgFrameMs, minFrameMs, maxFrameMs);
+        drawRightAlignedText(drawList, rightX, y, scale, white, line);
+
+        snprintf(line, sizeof(line), "Target %u Hz  |  %ux%u", targetRate, swapChain->getWidth(), swapChain->getHeight());
+        drawRightAlignedText(drawList, rightX, y, scale, white, line);
+
+        if (lastMemory.valid) {
+            snprintf(line, sizeof(line), "Heap %.0f MiB  (peak %.0f)", toMiB(lastMemory.heapMapped), toMiB(lastMemory.heapPeak));
+            drawRightAlignedText(drawList, rightX, y, scale, white, line);
+
+            snprintf(line, sizeof(line), "Direct memory free %.0f of %.0f MiB", toMiB(lastMemory.directFree), toMiB(lastMemory.directTotal));
+            drawRightAlignedText(drawList, rightX, y, scale, white, line);
+        }
+    }
+
+    // The frame-time graph, after PCSX2's: frame time in blue against the left axis, frame rate in green
+    // against the right one, on a translucent panel.
+    void PerformanceOverlay::drawGraph(float scale, float margin, float &y, float width) {
+        if (historyCount < 2) {
+            return;
+        }
+
+        float msMax = 0.0f;
+        float fpsMax = 0.0f;
+        for (size_t i = 0; i < historyCount; i++) {
+            msMax = std::max(msMax, frameTimeHistory[i]);
+            fpsMax = std::max(fpsMax, fpsHistory[i]);
+        }
+
+        const float Smoothing = 0.1f;
+        graphMsMax += (std::max(msMax * 1.1f, 20.0f) - graphMsMax) * Smoothing;
+        graphFpsMax += (std::max(fpsMax * 1.1f, 70.0f) - graphFpsMax) * Smoothing;
+
+        const float fontSize = ImGui::GetFontSize();
+        const float pad = 6.0f * scale;
+        const float labelWidth = ImGui::CalcTextSize("000.0").x + 4.0f * scale;
+        const ImVec2 graphSize(260.0f * scale, 80.0f * scale);
+        const float legendHeight = fontSize + pad;
+        const ImVec2 totalSize(labelWidth * 2.0f + graphSize.x + 2.0f * pad, graphSize.y + legendHeight + 2.0f * pad + fontSize * 0.5f);
+
+        ImGui::SetNextWindowPos(ImVec2(width - margin - totalSize.x, y + 4.0f * scale));
+        ImGui::SetNextWindowSize(totalSize);
+        ImGui::PushStyleColor(ImGuiCol_WindowBg, ImVec4(0.0f, 0.0f, 0.0f, 0.45f));
+        ImGui::PushStyleVar(ImGuiStyleVar_WindowRounding, 4.0f * scale);
+        ImGui::PushStyleVar(ImGuiStyleVar_WindowPadding, ImVec2(0.0f, 0.0f));
+        ImGui::PushStyleVar(ImGuiStyleVar_WindowBorderSize, 0.0f);
+        if (ImGui::Begin("##frame_times", nullptr, ImGuiWindowFlags_NoDecoration | ImGuiWindowFlags_NoInputs | ImGuiWindowFlags_NoSavedSettings | ImGuiWindowFlags_NoFocusOnAppearing | ImGuiWindowFlags_NoNav)) {
+            ImDrawList *drawList = ImGui::GetWindowDrawList();
+            const ImVec2 windowPos = ImGui::GetWindowPos();
+            const ImVec2 plotTL(windowPos.x + pad + labelWidth, windowPos.y + pad + fontSize * 0.5f);
+            const ImVec2 plotBR(plotTL.x + graphSize.x, plotTL.y + graphSize.y);
+            const ImU32 msColor = IM_COL32(100, 200, 255, 230);
+            const ImU32 fpsLineColor = IM_COL32(100, 255, 100, 230);
+
+            drawList->AddRectFilled(plotTL, plotBR, IM_COL32(0, 0, 0, 60));
+
+            const int ticks = 4;
+            char label[32];
+            for (int i = 0; i <= ticks; i++) {
+                const float fraction = float(i) / float(ticks);
+                const float gridY = plotBR.y - fraction * graphSize.y;
+                const float labelY = gridY - fontSize * 0.5f;
+                drawList->AddLine(ImVec2(plotTL.x, gridY), ImVec2(plotBR.x, gridY), IM_COL32(255, 255, 255, 40), 1.0f);
+
+                snprintf(label, sizeof(label), "%.1f", graphMsMin + (graphMsMax - graphMsMin) * fraction);
+                const float labelW = ImGui::CalcTextSize(label).x;
+                drawList->AddText(ImVec2(plotTL.x - labelW - 2.0f * scale, labelY), msColor, label);
+
+                snprintf(label, sizeof(label), "%.0f", graphFpsMin + (graphFpsMax - graphFpsMin) * fraction);
+                drawList->AddText(ImVec2(plotBR.x + 2.0f * scale, labelY), fpsLineColor, label);
+            }
+
+            ImGui::PushStyleColor(ImGuiCol_FrameBg, ImVec4(0, 0, 0, 0));
+            ImGui::PushStyleColor(ImGuiCol_Border, ImVec4(0, 0, 0, 0));
+            ImGui::PushStyleVar(ImGuiStyleVar_FrameBorderSize, 0.0f);
+            ImGui::PushStyleVar(ImGuiStyleVar_FramePadding, ImVec2(0.0f, 0.0f));
+
+            const int count = int(historyCount);
+            const int offset = (historyCount == HistorySize) ? int(historyPos) : 0;
+            ImGui::SetCursorScreenPos(plotTL);
+            ImGui::PushStyleColor(ImGuiCol_PlotLines, ImGui::ColorConvertU32ToFloat4(msColor));
+            ImGui::PlotLines("##frame_time_plot", frameTimeHistory.data(), count, offset, nullptr, graphMsMin, graphMsMax, graphSize);
+            ImGui::PopStyleColor();
+
+            ImGui::SetCursorScreenPos(plotTL);
+            ImGui::PushStyleColor(ImGuiCol_PlotLines, ImGui::ColorConvertU32ToFloat4(fpsLineColor));
+            ImGui::PlotLines("##fps_plot", fpsHistory.data(), count, offset, nullptr, graphFpsMin, graphFpsMax, graphSize);
+            ImGui::PopStyleColor();
+
+            ImGui::PopStyleVar(2);
+            ImGui::PopStyleColor(2);
+
+            // Legend: a coloured square and the current value for each line.
+            const float square = fontSize * 0.6f;
+            float legendX = plotTL.x;
+            const float legendY = plotBR.y + pad * 0.5f;
+            snprintf(label, sizeof(label), "Frame %.2f ms", avgFrameMs);
+            drawList->AddRectFilled(ImVec2(legendX, legendY + (fontSize - square) * 0.5f), ImVec2(legendX + square, legendY + (fontSize + square) * 0.5f), msColor);
+            legendX += square + 4.0f * scale;
+            drawList->AddText(ImVec2(legendX, legendY), IM_COL32(255, 255, 255, 255), label);
+            legendX += ImGui::CalcTextSize(label).x + 12.0f * scale;
+            snprintf(label, sizeof(label), "FPS %.1f", displayFps);
+            drawList->AddRectFilled(ImVec2(legendX, legendY + (fontSize - square) * 0.5f), ImVec2(legendX + square, legendY + (fontSize + square) * 0.5f), fpsLineColor);
+            legendX += square + 4.0f * scale;
+            drawList->AddText(ImVec2(legendX, legendY), IM_COL32(255, 255, 255, 255), label);
+        }
+
+        ImGui::End();
+        ImGui::PopStyleVar(3);
+        ImGui::PopStyleColor();
+        y += totalSize.y + 4.0f * scale;
+    }
+
+    void PerformanceOverlay::draw(RenderCommandList *commandList, uint32_t width, uint32_t height) {
+        const Mode mode = getMode();
+        if ((mode == Mode::Off) || (width == 0) || (height == 0)) {
+            return;
+        }
+
+        // Sizes are designed at 1080p and scaled to the output: 2x at 4K.
+        const float scale = float(height) / 1080.0f;
+        if (context == nullptr) {
+            initImGui(scale);
+        }
+
+        ImGuiContext *previous = ImGui::GetCurrentContext();
+        ImGui::SetCurrentContext(context);
+
+        ImGuiIO &io = ImGui::GetIO();
+        io.DisplaySize = ImVec2(float(width), float(height));
+        io.DeltaTime = 1.0f / 60.0f;
+        ImGui_ImplVulkan_NewFrame();
+        ImGui::NewFrame();
+
+        const float margin = 24.0f * scale;
+        float y = margin;
+        drawInfoBox(mode, scale, margin, y, float(width));
+        if ((mode == Mode::FpsAndGraph) || (mode == Mode::Detailed)) {
+            drawGraph(scale, margin, y, float(width));
+        }
+
+        ImGui::Render();
+        ImDrawData *drawData = ImGui::GetDrawData();
+        if (drawData != nullptr) {
+            VulkanCommandList *interfaceCommandList = static_cast<VulkanCommandList *>(commandList);
+            ImGui_ImplVulkan_RenderDrawData(drawData, interfaceCommandList->vk);
+        }
+
+        ImGui::SetCurrentContext(previous);
+    }
+};
