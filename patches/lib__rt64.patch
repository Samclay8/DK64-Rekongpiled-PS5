+// RT64
+//
+// Performance overlay (DK64 PS5 port): an info box and a frame-time graph in the top right corner of the
+// picture, drawn with Dear ImGui by the present thread over everything else. The layout follows PCSX2's
+// performance overlay (pcsx2/ImGui/ImGuiOverlays.cpp, GPL-3.0), as PS5SX2 shows it on the PS5.
+// Vulkan only. The mode is set from the frontend's Graphics settings.
+//
+
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <memory>
+#include <string>
+
+#include "common/rt64_plume.h"
+
+struct ImGuiContext;
+
+namespace RT64 {
+    struct PerformanceOverlayVulkan;
+
+    struct PerformanceOverlay {
+        enum class Mode : int {
+            Off = 0,
+            Fps = 1,
+            FpsAndGraph = 2,
+            Detailed = 3
+        };
+
+        static void setMode(Mode mode);
+        static Mode getMode();
+        static void setFontPath(const std::string &path);
+
+        PerformanceOverlay(RenderDevice *device, const RenderSwapChain *swapChain);
+        ~PerformanceOverlay();
+
+        // Called by the present thread for every frame it shows. newGameFrame is true for the first frame
+        // shown of each new frame the game drew (the others are RT64's interpolated frames).
+        void recordPresent(bool newGameFrame, uint32_t targetRate);
+
+        // Records the overlay into the command list, inside the swap chain framebuffer's render pass.
+        void draw(RenderCommandList *commandList, uint32_t width, uint32_t height);
+
+    private:
+        static constexpr size_t HistorySize = 240;
+        using Clock = std::chrono::steady_clock;
+
+        RenderDevice *device = nullptr;
+        const RenderSwapChain *swapChain = nullptr;
+        ImGuiContext *context = nullptr;
+        std::unique_ptr<PerformanceOverlayVulkan> vulkan;
+
+        // Every presented frame.
+        Clock::time_point lastPresent;
+        Clock::time_point windowStart;
+        Clock::time_point lastLog;
+        uint32_t windowPresents = 0;
+        uint32_t windowGameFrames = 0;
+        float windowMinMs = 0.0f;
+        float windowMaxMs = 0.0f;
+        std::array<float, HistorySize> frameTimeHistory = {};
+        std::array<float, HistorySize> fpsHistory = {};
+        size_t historyPos = 0;
+        size_t historyCount = 0;
+
+        // Updated once a second.
+        float displayFps = 0.0f;
+        float gameFps = 0.0f;
+        float avgFrameMs = 0.0f;
+        float minFrameMs = 0.0f;
+        float maxFrameMs = 0.0f;
+        uint32_t targetRate = 0;
+
+        // Smoothed graph scales, as PCSX2 does, so the axes don't jump.
+        float graphMsMin = 0.0f;
+        float graphMsMax = 33.4f;
+        float graphFpsMin = 0.0f;
+        float graphFpsMax = 70.0f;
+
+        void initImGui(float scale);
+        void drawInfoBox(Mode mode, float scale, float margin, float &y, float width);
+        void drawGraph(float scale, float margin, float &y, float width);
+    };
+};
