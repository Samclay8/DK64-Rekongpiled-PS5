+#if defined(__PROSPERO__)
+// PS5: code mods can't change while the game runs, and there's no launcher to change them before it starts.
+// Their switches stay usable: changes wait for the next start, and leaving the Manage Mods tab or closing the
+// menu offers to quit the game (config::create_mods_tab).
+static constexpr bool toggle_with_restart = true;
+#else
+static constexpr bool toggle_with_restart = false;
+#endif
+
+// While the game runs on the PS5, the switches show the next start: the pending changes, and the mods those
+// need (on and locked, as on other platforms), so the menu never shows a mod on without one it depends on.
+static bool use_next_start_view() {
+    return toggle_with_restart && ultramodern::is_game_started();
+}
+
+static bool is_mod_required(const std::string &mod_id) {
+    if (use_next_start_view()) {
+        return recomp::mods::is_mod_required_next_start(mod_id);
+    }
+    return recomp::mods::is_mod_auto_enabled(mod_id);
+}
+
 static bool is_mod_enabled_or_auto(const std::string &mod_id) {
+    if (use_next_start_view()) {
+        return recomp::mods::is_mod_enabled_next_start(mod_id) || recomp::mods::is_mod_required_next_start(mod_id);
+    }
     return recomp::mods::is_mod_enabled(mod_id) || recomp::mods::is_mod_auto_enabled(mod_id);
 }
 
