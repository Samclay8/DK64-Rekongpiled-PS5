+void recomp::mods::ModContext::set_next_start_change(const std::string& mod_id, bool enabled) {
+    std::unique_lock lock(opened_mods_mutex);
+    if (!opened_mods_by_id.contains(mod_id)) {
+        return;
+    }
+    // Switching back to what the running game has cancels the change.
+    if (enabled == enabled_mods.contains(mod_id)) {
+        next_start_changes.erase(mod_id);
+    }
+    else {
+        next_start_changes[mod_id] = enabled;
+    }
+}
+
+bool recomp::mods::ModContext::get_next_start_change(const std::string& mod_id, bool& enabled) const {
+    auto find_it = next_start_changes.find(mod_id);
+    if (find_it == next_start_changes.end()) {
+        return false;
+    }
+    enabled = find_it->second;
+    return true;
+}
+
+size_t recomp::mods::ModContext::count_next_start_changes() const {
+    return next_start_changes.size();
+}
+
+void recomp::mods::ModContext::apply_next_start_changes() {
+    std::unordered_set<std::string> next_enabled;
+    std::vector<std::string> order;
+    {
+        std::unique_lock lock(opened_mods_mutex);
+        // The running game keeps the mods it loaded. The choices go into the enabled set too, so a later save
+        // of the mod configuration doesn't undo them.
+        for (const auto& [mod_id, enabled] : next_start_changes) {
+            if (enabled) {
+                enabled_mods.emplace(mod_id);
+            }
+            else {
+                enabled_mods.erase(mod_id);
+            }
+#if defined(__PROSPERO__)
+            fprintf(stderr, "[mods] %s turned %s for the next start\n", mod_id.c_str(), enabled ? "on" : "off");
+#endif
+        }
+        next_start_changes.clear();
+        next_enabled = enabled_mods;
+        for (size_t mod_index : opened_mods_order) {
+            order.emplace_back(opened_mods[mod_index].manifest.mod_id);
+        }
+    }
+    // Written now rather than by the configuration thread: the game is closed straight after.
+    save_mods_config(mods_config_path, latest_game_mode, next_enabled, order);
+#if defined(__PROSPERO__)
+    fflush(stderr);
+#endif
+}
