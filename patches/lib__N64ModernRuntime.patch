+}
+
+// The enabled mods with the pending changes applied. Caller holds opened_mods_mutex.
+static std::unordered_set<std::string> next_start_enabled_set(
+    const std::unordered_set<std::string>& enabled_mods, const std::unordered_map<std::string, bool>& changes)
+{
+    std::unordered_set<std::string> enabled = enabled_mods;
+    for (const auto& [mod_id, mod_enabled] : changes) {
+        if (mod_enabled) {
+            enabled.emplace(mod_id);
+        }
+        else {
+            enabled.erase(mod_id);
+        }
+    }
+    return enabled;
+}
+
+bool recomp::mods::ModContext::is_mod_enabled_next_start(const std::string& mod_id) {
+    std::unique_lock lock(opened_mods_mutex);
+    return next_start_enabled_set(enabled_mods, next_start_changes).contains(mod_id);
+}
+
+bool recomp::mods::ModContext::is_mod_required_next_start(const std::string& mod_id) {
+    std::unique_lock lock(opened_mods_mutex);
+    const std::unordered_set<std::string> enabled = next_start_enabled_set(enabled_mods, next_start_changes);
+    // Follow the non-optional dependencies of every enabled mod, and theirs in turn.
+    std::unordered_set<std::string> required;
+    std::vector<std::string> pending(enabled.begin(), enabled.end());
+    while (!pending.empty()) {
+        const std::string cur_id = std::move(pending.back());
+        pending.pop_back();
+        auto find_it = opened_mods_by_id.find(cur_id);
+        if (find_it == opened_mods_by_id.end()) {
+            continue;
+        }
+        for (const Dependency& dependency : opened_mods[find_it->second].manifest.dependencies) {
+            if (!dependency.optional && required.emplace(dependency.mod_id).second) {
+                pending.emplace_back(dependency.mod_id);
+            }
+        }
+    }
+    return required.contains(mod_id);
+}
